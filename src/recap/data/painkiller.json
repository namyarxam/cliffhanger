      "episodes": [
        {
          "episode": 1,
          "name": "The One to Start With, the One to Stay With",
          "overview": "Seizing an opportunity, Richard bets on an opiate that relieves pain. College graduate Shannon takes a job at Purdue. Glen suffers a workplace injury.",
          "plot": "A physician prescribes OxyContin to one of his patients, who has unmanageable pain. He informs the patient that the effects of OxyContin last longer than the Vicodin the patient was taking, and as a result, they won't have to take OxyContin as frequently. He also mentions that it causes the same side effects as other opioids, particularly constipation. Richard Sackler is vilified over the prescription of OxyContin to patients who need to manage pain and to drug addicts.",
          "airDate": "2023-08-10",
          "still": "https://image.tmdb.org/t/p/original/gHrYO8fuxcVX3FEUg2T5Gi7dxEy.jpg",
          "stills": [
            "https://image.tmdb.org/t/p/original/gHrYO8fuxcVX3FEUg2T5Gi7dxEy.jpg"
          ]
        },
        {
          "episode": 2,
          "name": "Jesus Gave Me Water",
          "overview": "A patient using OxyContin attends a Purdue conference. Edie witnesses the drug's adverse effects. Richard faces roadblocks in his pursuit of profit.",
          "plot": "Arthur Sackler, Richard's uncle, is accused of wanting to sell OxyContin to as many people as possible to increase profits for his company, Purdue Pharma. Providers offer physicians coupons to distribute the Schedule 2 narcotic. A doctor tells Shannon Schaeffer, a new sales representative, that \"Oxycodone, that's what's in OxyContin. Morphine, codeine, hydrocodone, hydromorphone, diacetylmorphine, that's heroin. All come from the opium poppy\". Curtis Wright IV drags out approval at the FDA.",
          "airDate": "2023-08-10",
          "still": "https://image.tmdb.org/t/p/original/stgoV6loXt6TZRJyoXjPeUgUMj3.jpg",
          "stills": [
            "https://image.tmdb.org/t/p/original/stgoV6loXt6TZRJyoXjPeUgUMj3.jpg"
          ]
        },
        {
          "episode": 3,
          "name": "Blizzard of the Century",
          "overview": "Glen is forced to detox when his addiction lands him in the ER. Edie struggles to convince her new boss, the US Attorney, to build a case against Purdue.",
          "plot": "John L. Brownlee reviews the legal case against Purdue Pharma. Schaeffer's mentor reminds her, \"They're drug addicts. They existed long before OxyContin, and they'll exist long after OxyContin\". A prisoner reminisces about the 1990s crack epidemic in the United States. OxyContin addicts are becoming unemployed, committing robberies, auto thefts, filing for disability, and so on.",
          "airDate": "2023-08-10",
          "still": "https://image.tmdb.org/t/p/original/A7Wx8jCEzRdnpsbM9DC7FMMicRD.jpg",
          "stills": [
            "https://image.tmdb.org/t/p/original/A7Wx8jCEzRdnpsbM9DC7FMMicRD.jpg",
            "https://image.tmdb.org/t/p/original/aII3CJlEkC2Z09X1UDHMjapbwqV.jpg"
          ]
        },
        {
          "episode": 4,
          "name": "Is Believed",
          "overview": "Edie works to expose Purdue. Shannon enjoys the perks of her job but faces a moral dilemma. Pushed to the brink, Glen starts losing control at work.",
          "plot": "After the death of a young woman, Shannon Schaeffer tells a prescribing physician that \"She [the woman's mother] can't look at herself and say, 'I messed up. My daughter was a druggie'. She needs to blame someone\". Purdue advertisements claim that less than 1% of users develop an addiction to OxyContin, which is contradicted by statistics.",
          "airDate": "2023-08-10",
          "still": "https://image.tmdb.org/t/p/original/3qDdlvo9UhTVcv40pFzIrAHcRAF.jpg",
          "stills": [
            "https://image.tmdb.org/t/p/original/3qDdlvo9UhTVcv40pFzIrAHcRAF.jpg"
          ]
        },
        {
          "episode": 5,
          "name": "Hot! Hot! Hot!",
          "overview": "Glen hits rock bottom, Shannon attends a raucous work afterparty, and Edie uncovers damning evidence in her case against a pharmaceutical giant.",
          "plot": "The public and media notice and start applying pressure on Purdue Pharma. Glenn spirals downward with increasing doses of OxyContin, eventually turning to the black market, with dire consequences. Shannon sees deeper into the workings at Purdue and becomes disillusioned. Edie convinces her boss that OxyContin is a public health problem, and together, they come up with a strategy to go after the company.",
          "airDate": "2023-08-10",
          "still": "https://image.tmdb.org/t/p/original/q8M5kk83VYqLFTBi5Xztpul0Xzk.jpg",
          "stills": [
            "https://image.tmdb.org/t/p/original/q8M5kk83VYqLFTBi5Xztpul0Xzk.jpg",
            "https://image.tmdb.org/t/p/original/ulTlAWIAfxmcOq9gBMsIAvC3fCX.jpg",
            "https://image.tmdb.org/t/p/original/hjE2ezw7kvwovEsw6FaWOLeM654.jpg",
            "https://image.tmdb.org/t/p/original/huVCAFYt1hbOshI1nQzkhYcKXgz.jpg"
          ]
        },
        {
          "episode": 6,
          "name": "What's in a Name?",
          "overview": "Glen starts sobriety. Shannon reevaluates her role. Using new evidence, Edie and the team take Purdue to court as the case comes to a stunning end.",
          "plot": "Richard Sackler warns the corporate officers of Purdue Pharma that, \"They will dismantle everything we've built—brick by brick\".",
          "airDate": "2023-08-10",
          "still": "https://image.tmdb.org/t/p/original/xM5KVAUKXaVECKf0hNSS69tEGLb.jpg",
